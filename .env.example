# ==========================================
# SnapCut AI — Production Environment Config
# ==========================================

# 1. Frontend (Vite) Public Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_APP_BASE_URL=https://snapcut.ai
VITE_API_BASE_URL=https://snapcut.ai/api/v1

# 2. Supabase Server-Side & Service Role (Never expose in browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. AI Background Removal Provider Credentials
BACKGROUND_REMOVAL_PROVIDER=remove_bg # Options: remove_bg, clipdrop, photoroom
BACKGROUND_REMOVAL_API_KEY=your_remove_bg_api_key_here
CLIPDROP_API_KEY=your_clipdrop_api_key_here

# 4. Ephemeral Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Razorpay Payments Integration (INR)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 6. Automation & Gateway (n8n Cloud)
N8N_BASE_URL=https://your-instance.app.n8n.cloud
N8N_WEBHOOK_SECRET=your_n8n_bearer_secret

# 7. System & Logging
LOG_LEVEL=info
NODE_ENV=production
